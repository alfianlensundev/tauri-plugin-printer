{
  "name": "tauri-plugin-printer",
  "version": "2.0.0",
  "author": "Alfian Lensun <alfianlensundev@gmail.com>",
  "description": "Tauri v2 plugin for printer discovery, PDF/HTML printing, and print queue management on Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfianlensundev/tauri-plugin-printer.git"
  },
  "keywords": ["tauri", "tauri-plugin", "printer", "printing", "windows"],
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && rollup -c",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": ">=2.0.0",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.5",
    "rollup": "^4.9.6",
    "typescript": "^5.9.2",
    "tslib": "^2.8.1"
  }
}
